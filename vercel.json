{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_API_URL": "@next_public_api_url"
  },
  "buildCommand": "npm run build --ws",
  "outputDirectory": "packages/web/.next",
  "functions": {
    "api/**.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "packages/backend/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "packages/web/.next"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://github.com/mjawaidca-prog/canadian-payroll/tree/main/docs",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * *"
    }
  ]
}
