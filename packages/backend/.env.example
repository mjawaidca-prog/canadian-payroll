NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payroll_dev

# JWT Configuration (for future auth implementation)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Email Configuration (for pay stub delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@payroll.local

# API Configuration
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Tax Compliance
TAX_TABLE_UPDATE_CHECK_INTERVAL=86400000
CRA_DATA_SOURCE=https://www.canada.ca/taxes
